POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ContextFlow
POSTGRES_USER=postgres_sourava
POSTGRES_PASSWORD=contextflow123

DATABASE_URL=postgresql://postgres_sourava:contextflow123@localhost:5432/ContextFlow

ENCRYPTION_KEY=your-super-secret-encryption-key
HASH_SECRET=separate-secret-for-hmac-hashing
JWT_SECRET=separate-secret-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

SUPER_ADMIN_SECRET=super-admin-internal-secret-key

# ── GPU assignment ────────────────────────────────────────────────────────────
# Physical GPU 0 is reserved for Ollama VLM (set in start.sh when launching Ollama).
# The server process sees only physical GPU 1 (via CUDA_VISIBLE_DEVICES=1 in start.sh),
# so cuda:0 inside our process == physical GPU 1.
OLLAMA_CUDA_DEVICE=0
EMBED_DEVICE=cuda:0


# ── LLM provider ─────────────────────────────────────────────────────────────
# Set to "ollama" to use local Ollama instead
LLM_PROVIDER=ollama  #openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY= "you_openrouter-key" 
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Model names — OpenRouter ──────────────────────────────────────────────────
OPENROUTER_VLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SUMMARIZER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_GRAPH_MODEL=openai/gpt-oss-20b:free

# ── Model names — Ollama ──────────────────────────────────────────────────────
OLLAMA_VLM_MODEL=qwen3-vl:30b
OLLAMA_SUMMARIZER_MODEL=gpt-oss:20b
OLLAMA_GRAPH_MODEL=gemma4:e4b

# ── Parallel worker counts ────────────────────────────────────────────────────
GRAPH_EXTRACTION_WORKERS=10
ONTOLOGY_WORKERS=10
VLM_WORKERS=5
